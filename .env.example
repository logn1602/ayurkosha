# =============================================================
# AyurKosha — Environment Variables
# Copy this file to .env and fill in your actual keys
# NEVER commit .env to version control
# =============================================================

# Anthropic (Claude API)
ANTHROPIC_API_KEY=...

# Cohere (Embeddings + Reranking)
COHERE_API_KEY=...

# Pinecone (Vector Database)
PINECONE_API_KEY=...
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=ayurkosha

# Redis (Query Caching — optional for initial development)
REDIS_URL=redis://localhost:6379/0

# Pipeline Parameters
TOP_K_FINAL=6
BM25_RETRIEVE_N=50
SEMANTIC_RETRIEVE_N=50
RERANK_FIRST_PASS_N=15
RRF_K=60

# Embedding
EMBEDDING_MODEL=embed-multilingual-v3.0
EMBEDDING_DIMENSIONS=1024

# Generation
GENERATION_MODEL=claude-sonnet-4-6

# Logging
LOG_LEVEL=INFO

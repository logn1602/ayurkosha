# =============================================================
# AyurKosha — Environment Configuration (template)
# Copy to .env and fill in your API keys:  cp .env.example .env
# =============================================================

# ── API Keys (required) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
COHERE_API_KEY=your-cohere-key-here
PINECONE_API_KEY=your-pinecone-key-here

# ── Pinecone ───────────────────────────────────────────────
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=ayurkosha

# ── Redis (optional; used for query caching) ───────────────
REDIS_URL=redis://localhost:6379/0

# ── Pipeline Parameters ────────────────────────────────────
TOP_K_FINAL=6
BM25_RETRIEVE_N=50
SEMANTIC_RETRIEVE_N=50
RERANK_FIRST_PASS_N=15
RRF_K=60

# ── Embedding ──────────────────────────────────────────────
EMBEDDING_MODEL=embed-multilingual-v3.0
EMBEDDING_DIMENSIONS=1024

# ── Generation ─────────────────────────────────────────────
GENERATION_MODEL=claude-sonnet-4-6

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
